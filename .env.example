# ---------------------------------------------------------------------------
# Flua — environment configuration
#
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# Only DATABASE_URL and AUTH_SECRET are strictly required for the app to boot.
# Every AI provider key is optional: Flua runs with zero, one, or all three
# providers configured and reports what is missing on the /admin screen.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string.
# Local example:  postgresql://postgres:postgres@localhost:5432/flua?schema=public
# Neon/Supabase:  postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flua?schema=public"

# Secret used to sign session JWTs. MUST be at least 32 characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# --- AI providers (all optional) ------------------------------------------

# Google Gemini — https://aistudio.google.com/apikey
# Free tier available. Used for text, streaming and structured output.
GEMINI_API_KEY=""

# Groq — https://console.groq.com/keys
# Free tier available. Fast text generation AND Whisper speech-to-text.
GROQ_API_KEY=""

# OpenRouter — https://openrouter.ai/keys
# Has free-tier models (`:free` suffix). Used as a last-resort text fallback.
OPENROUTER_API_KEY=""

# --- Provider routing -----------------------------------------------------
# Order in which text providers are attempted. Values: gemini | groq | openrouter
# A provider without an API key is skipped automatically, so these can stay as-is.
PRIMARY_AI_PROVIDER="gemini"
SECONDARY_AI_PROVIDER="groq"
TERTIARY_AI_PROVIDER="openrouter"

# --- Optional tuning ------------------------------------------------------

# Per-request timeout for a single AI provider call, in milliseconds.
AI_REQUEST_TIMEOUT_MS="45000"

# Max attempts (including the first) against a single provider before failing over.
AI_MAX_ATTEMPTS_PER_PROVIDER="2"

# Comma-separated list of emails allowed to open /admin.
# Leave empty to allow no one (the admin area then 404s for everybody).
ADMIN_EMAILS=""

# Log level: debug | info | warn | error
LOG_LEVEL="info"

# Public site URL — used for password-reset links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
